#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Original ClothCraft test fixture, authored from explicit coordinates.
# This is a deformed panel snapshot, not a serialized editable garment.
def Xform "World"
{
    def Scope "Garment"
    {
        custom int clothcraft:snapshotVersion = 1
        custom double clothcraft:timeSeconds = 0.5
        def Mesh "panel_612d62"
        {
            custom string clothcraft:panelId = "a-b"
            uniform token subdivisionScheme = "none"
            uniform token orientation = "rightHanded"
            uniform bool doubleSided = true
            point3f[] points = [(0, 1, 0), (0.25, 1, 0), (0, 0.5, 0), (0.25, 0.5, 0.125)]
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 3, 0, 3, 2]
            custom double2[] clothcraft:restUV = [(0, 0), (0.25, 0), (0, 0.5), (0.25, 0.5)]
            texCoord2f[] primvars:st = [(0, 0), (0.25, 0), (0, 0.5), (0.25, 0.5)] (
                interpolation = "vertex"
            )
            color3f[] primvars:displayColor = [(0.62, 0.68, 0.78)] (
                interpolation = "constant"
            )
        }
    }
}
